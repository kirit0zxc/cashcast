# Пример переменных окружения. Скопируйте в infra/.env и при необходимости измените.
# Реальные секреты в репозиторий не коммитим.

# --- PostgreSQL ---
POSTGRES_USER=cashcast
POSTGRES_PASSWORD=cashcast
POSTGRES_DB=cashcast

# --- Backend (префикс CC_) ---
CC_DATABASE_URL=postgresql+psycopg://cashcast:cashcast@postgres:5432/cashcast
CC_APP_ENV=dev
# За HTTPS (публичный стенд) выставить true.
CC_COOKIE_SECURE=false

# --- Демо-данные ---
# migrate-контейнер засеет демо-пользователя и компанию при CC_SEED_DEMO=true.
CC_SEED_DEMO=true
CC_DEMO_EMAIL=demo@example.com
CC_DEMO_PASSWORD=demo-password

# --- Web ---
WEB_PORT=8080

# --- Необязательный ИИ-ассистент (секрет только api) ---
CC_OPENROUTER_API_KEY=
CC_ASSISTANT_MODEL=deepseek/deepseek-v4.1-flash-1017
CC_ASSISTANT_DAILY_TURNS=100
